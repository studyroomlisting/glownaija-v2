# ════════════════════════════════════════════════════════════
#  GlowNaija — Environment Variables
#  Copy this file to .env.local and fill in all values
#  Never commit .env.local to version control
# ════════════════════════════════════════════════════════════

# ── Supabase ─────────────────────────────────────────────────
# Get from: supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# ── Stripe ───────────────────────────────────────────────────
# Get from: stripe.com → Developers → API Keys
# Use test keys (pk_test_..., sk_test_...) for development
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Get from: stripe.com → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Resend (email) ───────────────────────────────────────────
# Get from: resend.com → API Keys
# Leave blank to skip emails (they'll log to console instead)
RESEND_API_KEY=re_...
EMAIL_FROM=GlowNaija <hello@glownaija.co.uk>

# ── Anthropic (Glow AI chat) ─────────────────────────────────
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ── App ──────────────────────────────────────────────────────
# Development: http://localhost:3000
# Production:  https://glownaija.co.uk (or your Vercel URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Cron protection ──────────────────────────────────────────
# Generate: openssl rand -hex 32
# Used to protect /api/cron/reminders from unauthorized calls
CRON_SECRET=your-random-secret-here
